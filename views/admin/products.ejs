<%- include('../includes/head.ejs') %>

</head>
<body>

    <%- include('../includes/navigation.ejs') %>

    <main>

        <% if (prods.length) { %>
            <div class="product-grid">
                <% for(let product of prods) { %>
                    <div class="card">  
                        <img src="<%= product.imageUrl %>" alt="Produit 1"> <!-- Remplacez par l'URL de votre image -->  
                        <h2><%= product.title %></h2>  
                        <p class="price">€<%= product.price %></p>  
                        <p class="description"><%= product.description %></p>
                        <div class="card_action">
                            <a href="/admin/edit-product/<%= product._id %>?edit=true" class="cart_btn edit">Edit</a>
                            <form action="/admin/delete-product" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="productId" value="<%= product._id %>">
                                <button class="cart_btn delete" type="submit">Delete</button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <h1>No Products Found</h1>
        <% } %>
    </main>

<%- include('../includes/end.ejs') %>