<%- include('../includes/head.ejs') %>

</head>
<body>

    <%- include('../includes/navigation.ejs') %>

    <main>
        <% if(orders.length <= 0) { %>

        <h1>Nothing There!</h1>

        <% } else { %>

            <ul class="list">
                <% orders.forEach(order => {%>
                    <li class="lis">
                        <h2> # <%= order._id %></h2>
                        <ul>
                            <% order.items.forEach(product => {  %>
                                <li><%= product.title  %> (<%= product.quantity  %>)</li>
                            <% });  %>
                        </ul>
                    </li>
                <% });  %>
            </ul>

        <% } %>
    </main>

    <%- include('../includes/end.ejs') %>